{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turva-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],
  // Off on purpose, same reason as turva-worker: the MCP endpoint is reachable at
  // mcp.turva.dev only, not additionally on a *.workers.dev hostname.
  "workers_dev": false,
  // Also off on purpose: per-version Preview URLs
  // would serve each uploaded version at <version>-turva-mcp.<subdomain>.workers.dev, a
  // second hostname outside the turva.dev zone, which is the exposure workers_dev: false closes
  // above. Wrangler's schema (config-schema.json) documents the key and defaults it to false;
  // it is written out so the invariant does not rest on a default.
  "preview_urls": false,
  // The endpoint declares a RateLimit-Policy of 100 requests per 60 seconds on every
  // response, and this binding is what applies it. The binding counts per Cloudflare
  // location and approximately, so the header states the configured quota and not an exact
  // ceiling. RATE_LIMIT in src/index.ts carries the same two numbers, and
  // test/protocol.test.ts compares them with this entry. namespace_id is deliberately NOT 1001:
  // bindings that share a namespace_id share counters across Workers on the same account,
  // which would silently drain turva-worker's per-IP budget (measured 2026-07-17).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  // get_page reads turva.dev's own pages through this service binding to the site Worker. A
  // service binding is a Worker-to-Worker call inside Cloudflare: it never leaves the network
  // and cannot be pointed at another host, which is why get_page uses it and not a fetch to a
  // URL. src/index.ts SITE is typed optional so a test without the binding still runs.
  "services": [
    { "binding": "SITE", "service": "turva-worker" }
  ],
  "observability": {
    "enabled": false
  },
  // No Durable Object. The 2026-07-28 revision is stateless: every POST is
  // self-contained, there is no session to keep alive, and the handler builds a
  // fresh server per request. The v1 migration stays because migration history is
  // append-only; v2 deletes the class that v1 created.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TurvaMCP"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["TurvaMCP"]
    }
  ]
}
