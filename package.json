{
  "name": "turva-mcp",
  "version": "1.6.16",
  "private": true,
  "description": "MCP server for turva.dev. Exposes the service catalog, agent-readiness scores, security evidence and engagement principles to AI agents.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Erik Rekola",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260523.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "@cloudflare/workers-types": "$@cloudflare/workers-types",
    "@modelcontextprotocol/client": "$@modelcontextprotocol/client",
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true,
    "workerd@1.20261006.1": true
  }
}
