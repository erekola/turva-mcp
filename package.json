    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "zod": "^4.6.2"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "@cloudflare/workers-types": "$@cloudflare/workers-types"
  },
  "allowScripts": {
