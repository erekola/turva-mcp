{
  "name": "turva-mcp",
  "version": "1.10.1",
  "private": true,
  "description": "MCP server for turva.dev. Exposes the service catalog, agent-readiness scores, security evidence, engagement principles and contact details to AI agents.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "Erik Rekola",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260523.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "@cloudflare/workers-types": "$@cloudflare/workers-types"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true,
    "workerd@1.20261110.1": true
  }
}
